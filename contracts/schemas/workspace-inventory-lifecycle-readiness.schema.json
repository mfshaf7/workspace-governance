{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "readiness_id", "readiness_digest", "evaluated_at", "request_ref", "target", "action", "observed_state", "policy_ref", "outcome", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "workspace-inventory-lifecycle-readiness" },
    "readiness_id": { "$ref": "#/$defs/text" },
    "readiness_digest": { "$ref": "#/$defs/digest" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "request_ref": { "$ref": "#/$defs/artifactRef" },
    "target": { "$ref": "#/$defs/target" },
    "action": { "enum": ["update", "suspend", "restore", "retire"] },
    "observed_state": { "$ref": "#/$defs/expectedState" },
    "policy_ref": { "$ref": "#/$defs/artifactRef" },
    "outcome": { "enum": ["ready", "blocked"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactRef": { "type": "object", "required": ["id", "digest"], "properties": { "id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "target": { "type": "object", "required": ["kind", "name", "record_id"], "properties": { "kind": { "enum": ["repo", "product", "component"] }, "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "record_id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" } }, "additionalProperties": false },
    "expectedState": { "type": "object", "required": ["active_inventory_digest", "history_digest", "record_version", "record_digest", "posture"], "properties": { "active_inventory_digest": { "$ref": "#/$defs/digest" }, "history_digest": { "$ref": "#/$defs/digest" }, "record_version": { "type": "integer", "minimum": 1 }, "record_digest": { "$ref": "#/$defs/digest" }, "posture": { "enum": ["active", "suspended", "retired"] } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
