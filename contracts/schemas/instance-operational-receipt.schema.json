{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal operational record durable receipt",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "authority",
    "instance_id",
    "record_id",
    "version",
    "record_digest",
    "previous",
    "idempotency_key",
    "command_digest",
    "actor",
    "action",
    "accepted_at",
    "policy_ref",
    "decision_digest",
    "readiness_digest",
    "operator_ref",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact_type": {
      "const": "instance-operational-record-receipt"
    },
    "authority": {
      "const": "internal-instance-record"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^repo:[a-z0-9][a-z0-9._-]{0,185}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "record_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous": {
      "type": "object",
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "version": {
              "type": "null"
            },
            "digest": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "version": {
              "type": "integer"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "readiness_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operator_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ai_decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
