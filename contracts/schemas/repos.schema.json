{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "repos", "retired_repos"],
  "properties": {
    "schema_version": { "const": 2 },
    "repos": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["record", "posture", "lifecycle", "repo_class", "requires_security_bindings", "owns", "must_not_own", "allowed_authoritative_refs", "validation_behavior"],
        "properties": {
          "record": { "$ref": "#/$defs/recordEnvelope" },
          "posture": { "enum": ["active", "suspended"] },
          "lifecycle": { "type": "string", "minLength": 1 },
          "repo_class": { "type": "string", "minLength": 1 },
          "requires_security_bindings": { "type": "boolean" },
          "security_review_subject": { "type": "boolean" },
          "owns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "must_not_own": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "allowed_authoritative_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "validation_behavior": { "$ref": "#/$defs/validationBehavior" }
        },
        "additionalProperties": false
      }
    },
    "retired_repos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["record", "posture", "lifecycle", "replaced_by"],
        "properties": {
          "record": { "$ref": "#/$defs/recordEnvelope" },
          "posture": { "const": "retired" },
          "lifecycle": { "const": "retired" },
          "replaced_by": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableText": { "type": ["string", "null"], "minLength": 1 },
    "recordEnvelope": {
      "type": "object",
      "required": ["id", "version", "lineage", "last_mutation"],
      "properties": {
        "id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "lineage": {
          "type": "object",
          "required": ["source", "source_ref", "source_digest", "intake_entry_version"],
          "properties": {
            "source": { "enum": ["legacy-migration", "workspace-intake"] },
            "source_ref": { "type": "string", "minLength": 1 },
            "source_digest": { "$ref": "#/$defs/digest" },
            "intake_entry_version": { "type": ["integer", "null"], "minimum": 1 }
          },
          "additionalProperties": false
        },
        "last_mutation": {
          "type": "object",
          "required": ["id", "action", "idempotency_key", "request_ref", "request_digest", "readiness_ref", "readiness_digest", "applied_at"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "action": { "enum": ["migrate", "promote"] },
            "idempotency_key": { "type": "string", "minLength": 1 },
            "request_ref": { "$ref": "#/$defs/nullableText" },
            "request_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
            "readiness_ref": { "$ref": "#/$defs/nullableText" },
            "readiness_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
            "applied_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validationBehavior": {
      "type": "object",
      "required": ["posture", "wgcf_graph_role", "catalog_refs", "notes"],
      "properties": {
        "posture": { "type": "string", "minLength": 1 },
        "wgcf_graph_role": { "type": "string", "minLength": 1 },
        "catalog_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
