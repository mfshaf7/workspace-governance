{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "artifact_type", "mutation_id", "request_ref", "readiness_ref", "target", "source_branch", "applied_at", "changes", "mutation_digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "workspace-inventory-promotion-mutation" },
    "mutation_id": { "$ref": "#/$defs/text" },
    "request_ref": { "$ref": "#/$defs/ref" },
    "readiness_ref": { "$ref": "#/$defs/ref" },
    "target": { "$ref": "#/$defs/target" },
    "source_branch": { "$ref": "#/$defs/text" },
    "applied_at": { "type": "string", "format": "date-time" },
    "changes": {
      "type": "object",
      "required": ["intake_entry_removed", "active_record_added", "active_record_version"],
      "properties": {
        "intake_entry_removed": { "const": true },
        "active_record_added": { "const": true },
        "active_record_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "mutation_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ref": { "type": "object", "required": ["id", "digest"], "properties": { "id": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "target": { "type": "object", "required": ["kind", "name", "record_id"], "properties": { "kind": { "enum": ["repo", "product", "component"] }, "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "record_id": { "type": "string", "pattern": "^(repo|product|component):[a-z0-9][a-z0-9._-]*$" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
