{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted internal repository inventory transition",
  "type": "object",
  "required": [
    "schema_version",
    "instance_id",
    "request_id",
    "requested_at",
    "target",
    "policy_ref",
    "idempotency_key",
    "request_digest",
    "artifact_type",
    "action",
    "operator_ref",
    "correlation_ref",
    "expected_state",
    "requested_value",
    "prior_receipt_digest",
    "reason",
    "impact_acknowledgements",
    "approval_refs",
    "operator_acceptance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "record_id"
      ],
      "properties": {
        "kind": {
          "const": "repo"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 186
        },
        "record_id": {
          "type": "string",
          "pattern": "^repo:[a-z0-9][a-z0-9._-]*$",
          "maxLength": 191
        }
      },
      "additionalProperties": false
    },
    "policy_ref": {
      "type": "object",
      "required": [
        "repo",
        "revision",
        "contract_digest"
      ],
      "properties": {
        "repo": {
          "const": "workspace-governance"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "artifact_type": {
      "const": "instance-repository-inventory-request"
    },
    "action": {
      "enum": [
        "promote",
        "update",
        "suspend",
        "restore",
        "retire"
      ]
    },
    "operator_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlation_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_state": {
      "type": "object",
      "required": [
        "record_version",
        "record_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "record_version": {
          "type": "integer",
          "minimum": 1
        },
        "record_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "requested_value": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "prior_receipt_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "impact_acknowledgements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operator_acceptance": {
      "type": "object",
      "required": [
        "state",
        "operator_ref",
        "recorded_at"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "accepted"
        },
        "operator_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "providerRepository": {
      "type": "object",
      "required": [
        "provider",
        "provider_repository_id",
        "full_name"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "provider_repository_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validationBehavior": {
      "type": "object",
      "required": [
        "posture",
        "wgcf_graph_role",
        "catalog_refs",
        "notes"
      ],
      "properties": {
        "posture": {
          "$ref": "#/$defs/text"
        },
        "wgcf_graph_role": {
          "$ref": "#/$defs/text"
        },
        "catalog_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "repoRecord": {
      "type": "object",
      "required": [
        "kind",
        "repo_class",
        "requires_security_bindings",
        "security_owner",
        "notes",
        "provider_repository"
      ],
      "properties": {
        "kind": {
          "const": "repo"
        },
        "repo_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_repository": {
          "$ref": "#/$defs/providerRepository"
        },
        "requires_security_bindings": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "security_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "$ref": "#/$defs/text"
        },
        "validation_behavior": {
          "$ref": "#/$defs/validationBehavior"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "promote",
              "update"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "object",
            "minProperties": 1
          }
        }
      },
      "else": {
        "properties": {
          "requested_value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "restore"
          }
        }
      },
      "then": {
        "properties": {
          "prior_receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "prior_receipt_digest": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "promote"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          },
          "impact_acknowledgements": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "impact_acknowledgements": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
