{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "runtime_compositions", "profiles"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "runtime_compositions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/runtimeComposition" }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "lifecycle",
          "lane_class",
          "owner_repo",
          "summary",
          "purpose",
          "validation_behavior",
          "profile_path",
          "runtime_owner",
          "security_owner",
          "requested_by",
          "requested_on",
          "request_record",
          "shared_dependencies",
          "source_repos",
          "stage_handoff",
          "actions"
        ],
        "properties": {
          "lifecycle": { "type": "string", "minLength": 1 },
          "lane_class": { "type": "string", "minLength": 1 },
          "owner_repo": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "validation_behavior": { "$ref": "#/$defs/validationBehavior" },
          "profile_path": { "type": "string", "minLength": 1 },
          "runtime_owner": { "type": "string", "minLength": 1 },
          "security_owner": { "type": "string", "minLength": 1 },
          "requested_by": { "type": "string", "minLength": 1 },
          "requested_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "request_record": {
            "type": "object",
            "required": ["system", "ref"],
            "properties": {
              "system": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "build_admission": {
            "type": "object",
            "required": [
              "approved_by",
              "approved_on",
              "platform_acceptance_ref",
              "security_review_required",
              "security_review_refs",
              "implementation_allowed",
              "self_serve_launch_allowed",
              "work_item_ref"
            ],
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "platform_acceptance_ref": {
                "type": "string",
                "minLength": 1
              },
              "security_review_required": { "type": "boolean" },
              "security_review_refs": {
                "type": "array",
                "items": { "$ref": "#/$defs/securityReviewRef" }
              },
              "implementation_allowed": { "type": "boolean" },
              "self_serve_launch_allowed": { "type": "boolean" },
              "work_item_ref": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "admission": {
            "type": "object",
            "required": [
              "approved_by",
              "approved_on",
              "platform_acceptance_ref",
              "security_review_required",
              "security_review_refs"
            ],
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "platform_acceptance_ref": {
                "type": "string",
                "minLength": 1
              },
              "security_review_required": { "type": "boolean" },
              "security_review_refs": {
                "type": "array",
                "items": { "$ref": "#/$defs/securityReviewRef" }
              }
            },
            "additionalProperties": false
          },
          "shared_dependencies": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_repos": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "stage_handoff": {
            "type": "object",
            "required": ["owner_repo", "governed_surface", "required_checks"],
            "properties": {
              "owner_repo": { "type": "string", "minLength": 1 },
              "governed_surface": { "type": "string", "minLength": 1 },
              "required_checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environmentVariable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "runtimeComposition": {
      "type": "object",
      "required": [
        "lifecycle",
        "owner_repo",
        "summary",
        "root_profile_id",
        "profiles",
        "dependencies",
        "caller_bindings",
        "credential_bindings",
        "profile_bindings",
        "execution"
      ],
      "properties": {
        "lifecycle": { "type": "string", "minLength": 1 },
        "owner_repo": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "root_profile_id": { "$ref": "#/$defs/identifier" },
        "profiles": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": ["required_lifecycle"],
            "properties": {
              "required_lifecycle": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["consumer_profile_id", "provider_profile_id"],
            "properties": {
              "consumer_profile_id": { "$ref": "#/$defs/identifier" },
              "provider_profile_id": { "$ref": "#/$defs/identifier" },
              "endpoint_projections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "environment_variable",
                    "address_format",
                    "service_name",
                    "service_port"
                  ],
                  "properties": {
                    "environment_variable": { "$ref": "#/$defs/environmentVariable" },
                    "address_format": { "enum": ["url", "host-port"] },
                    "scheme": { "enum": ["http", "https"] },
                    "service_name": { "$ref": "#/$defs/identifier" },
                    "service_port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "address_format": { "const": "url" } },
                        "required": ["address_format"]
                      },
                      "then": { "required": ["scheme"] },
                      "else": { "not": { "required": ["scheme"] } }
                    }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "caller_bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": [
              "owner_repo",
              "purpose",
              "caller_id",
              "consumer_profile_id",
              "provider_profile_id",
              "consumer_environment_variable",
              "provider_environment_variable"
            ],
            "properties": {
              "owner_repo": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "caller_id": { "type": "string", "minLength": 1 },
              "consumer_profile_id": { "$ref": "#/$defs/identifier" },
              "provider_profile_id": { "$ref": "#/$defs/identifier" },
              "consumer_environment_variable": { "$ref": "#/$defs/environmentVariable" },
              "provider_environment_variable": { "$ref": "#/$defs/environmentVariable" }
            },
            "additionalProperties": false
          }
        },
        "credential_bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": [
              "owner_repo",
              "purpose",
              "value_source",
              "retention",
              "projections"
            ],
            "properties": {
              "owner_repo": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "value_source": { "const": "runtime-generated" },
              "retention": { "const": "composition-lifetime" },
              "projections": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["profile_id", "environment_variable"],
                  "properties": {
                    "profile_id": { "$ref": "#/$defs/identifier" },
                    "environment_variable": { "$ref": "#/$defs/environmentVariable" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "profile_bindings": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": [
              "owner_repo",
              "purpose",
              "profile_id",
              "environment_variable",
              "source"
            ],
            "properties": {
              "owner_repo": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "profile_id": { "$ref": "#/$defs/identifier" },
              "environment_variable": { "$ref": "#/$defs/environmentVariable" },
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["kind", "value"],
                    "properties": {
                      "kind": { "const": "literal" },
                      "value": { "type": "string", "minLength": 1 }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "address_format",
                      "scheme",
                      "service_name",
                      "service_port"
                    ],
                    "properties": {
                      "kind": { "const": "profile-service" },
                      "address_format": { "const": "url" },
                      "scheme": { "enum": ["http", "https"] },
                      "service_name": { "$ref": "#/$defs/identifier" },
                      "service_port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "address_format",
                      "service_name",
                      "service_port"
                    ],
                    "properties": {
                      "kind": { "const": "profile-service" },
                      "address_format": { "const": "host-port" },
                      "service_name": { "$ref": "#/$defs/identifier" },
                      "service_port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "template"],
                    "properties": {
                      "kind": { "const": "operator-template" },
                      "template": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]*\\{operator\\}[a-z0-9-]*$"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["kind", "source_profile_id"],
                    "properties": {
                      "kind": { "const": "profile-namespace" },
                      "source_profile_id": { "$ref": "#/$defs/identifier" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "execution": {
          "type": "object",
          "required": [
            "startup_action",
            "readiness_action",
            "teardown_action",
            "startup_order",
            "teardown_order",
            "cleanup_owner_repo",
            "rollback_started_profiles_on_failure",
            "preserve_profile_state_on_teardown"
          ],
          "properties": {
            "startup_action": { "$ref": "#/$defs/identifier" },
            "readiness_action": { "$ref": "#/$defs/identifier" },
            "teardown_action": { "$ref": "#/$defs/identifier" },
            "startup_order": { "const": "dependency-first" },
            "teardown_order": { "const": "reverse-startup" },
            "cleanup_owner_repo": { "type": "string", "minLength": 1 },
            "rollback_started_profiles_on_failure": { "const": true },
            "preserve_profile_state_on_teardown": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "securityReviewRef": {
      "type": "object",
      "required": ["repo", "path"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "dependentRequired": {
        "source_commit": ["content_sha256"],
        "content_sha256": ["source_commit"]
      },
      "additionalProperties": false
    },
    "validationBehavior": {
      "type": "object",
      "required": ["posture", "wgcf_graph_role", "catalog_refs", "notes"],
      "properties": {
        "posture": { "type": "string", "minLength": 1 },
        "wgcf_graph_role": { "type": "string", "minLength": 1 },
        "catalog_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
