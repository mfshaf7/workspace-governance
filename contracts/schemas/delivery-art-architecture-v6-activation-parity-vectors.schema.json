{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/contracts/schemas/delivery-art-architecture-v6-activation-parity-vectors.schema.json",
  "title": "Delivery ART Architecture V6 Activation Parity Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_packet_schema_version", "vectors"],
  "properties": {
    "schema_version": { "const": 1 },
    "architecture_packet_schema_version": { "const": 6 },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "landing_units",
          "source_landing_edges",
          "work_item_execution_plan",
          "human_gate",
          "runtime_activation_chain"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "landing_units": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "owner_repo", "source_backed", "covered_work_item_ids"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "owner_repo": { "$ref": "#/$defs/repoName" },
                "source_backed": { "const": true },
                "covered_work_item_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/workItemId" }
                }
              }
            }
          },
          "source_landing_edges": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prerequisite_landing_unit_id", "dependent_landing_unit_id"],
              "properties": {
                "prerequisite_landing_unit_id": { "$ref": "#/$defs/identifier" },
                "dependent_landing_unit_id": { "$ref": "#/$defs/identifier" }
              }
            }
          },
          "work_item_execution_plan": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["work_item_id", "start_after_work_item_ids"],
              "properties": {
                "work_item_id": { "$ref": "#/$defs/workItemId" },
                "start_after_work_item_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/workItemId" }
                }
              }
            }
          },
          "human_gate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gate_id", "authority_work_item_id", "blocked_transition", "affected_landing_unit_ids"],
            "properties": {
              "gate_id": { "$ref": "#/$defs/identifier" },
              "authority_work_item_id": { "$ref": "#/$defs/workItemId" },
              "blocked_transition": { "const": "before_runtime_activation" },
              "affected_landing_unit_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          },
          "runtime_activation_chain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain_id",
              "gate_id",
              "source_owner_repo",
              "source_activation_posture",
              "source_activation_evidence",
              "source_activation_landing_unit_id",
              "commissioning_landing_unit_ids"
            ],
            "properties": {
              "chain_id": { "$ref": "#/$defs/identifier" },
              "gate_id": { "$ref": "#/$defs/identifier" },
              "source_owner_repo": { "$ref": "#/$defs/repoName" },
              "source_activation_posture": { "const": "owner-source-change-required" },
              "source_activation_evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["repo", "revision", "path", "field", "observed_value", "observed_posture"],
                "properties": {
                  "repo": { "$ref": "#/$defs/repoName" },
                  "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "path": { "type": "string", "minLength": 1 },
                  "field": { "type": "string", "minLength": 1 },
                  "observed_value": {
                    "oneOf": [
                      { "type": "boolean" },
                      { "type": "string", "minLength": 1 }
                    ]
                  },
                  "observed_posture": { "enum": ["source-ready", "owner-source-change-required"] }
                }
              },
              "source_activation_landing_unit_id": { "$ref": "#/$defs/identifier" },
              "commissioning_landing_unit_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "repoName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "workItemId": { "type": "string", "pattern": "^work-item-[1-9][0-9]*$" }
  }
}
