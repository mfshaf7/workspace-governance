{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "owner_repo", "operator_surface_path", "architecture", "purpose", "canonical_truth", "record_contract", "promotion_contract", "review_boundary", "migration", "routine_operation", "denied_shortcuts"],
  "properties": {
    "schema_version": { "const": 1 },
    "owner_repo": { "const": "workspace-governance" },
    "operator_surface_path": { "const": "docs/workspace-active-inventory.md" },
    "architecture": { "type": "object", "required": ["initiative_ref", "contract_work_ref"], "additionalProperties": { "$ref": "#/$defs/text" } },
    "purpose": { "$ref": "#/$defs/text" },
    "canonical_truth": { "$ref": "#/$defs/section" },
    "record_contract": { "$ref": "#/$defs/section" },
    "promotion_contract": { "$ref": "#/$defs/section" },
    "review_boundary": { "$ref": "#/$defs/section" },
    "migration": { "$ref": "#/$defs/section" },
    "routine_operation": { "$ref": "#/$defs/routineOperationRef" },
    "denied_shortcuts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "section": { "type": "object", "minProperties": 1 },
    "routineOperationRef": {
      "type": "object",
      "required": ["contract_ref", "capability", "baseline_posture", "rule"],
      "properties": {
        "contract_ref": { "const": "contracts/workspace-intake-inventory-operation.yaml" },
        "capability": { "const": "workspace-active-inventory-promotion" },
        "baseline_posture": { "const": "source-complete-conformance-only" },
        "rule": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
