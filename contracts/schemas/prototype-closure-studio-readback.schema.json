{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Closure Merged Studio Readback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "readback_id", "prototype_id", "source_event_ref", "source_event_digest", "merged_source_revision", "observed_lifecycle", "observed_source_custody", "observed_at"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_type": {"const": "prototype-closure-studio-readback"},
    "readback_id": {"$ref": "#/$defs/text"},
    "prototype_id": {"$ref": "#/$defs/text"},
    "source_event_ref": {"$ref": "#/$defs/text"},
    "source_event_digest": {"$ref": "#/$defs/digest"},
    "merged_source_revision": {"$ref": "#/$defs/text"},
    "observed_lifecycle": {"enum": ["exploring", "graduating", "graduated", "retired"]},
    "observed_source_custody": {"enum": ["incubation-repo", "dedicated-owner-repo", "shared-owner-repo"]},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
