{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "owner_repo", "operator_surface_path", "architecture", "purpose", "canonical_truth", "actions", "state_axes", "command_contract", "history_contract", "review_boundary", "denied_shortcuts"],
  "properties": {
    "schema_version": { "const": 1 },
    "owner_repo": { "const": "workspace-governance" },
    "operator_surface_path": { "const": "docs/workspace-active-inventory.md" },
    "architecture": { "$ref": "#/$defs/section" },
    "purpose": { "$ref": "#/$defs/text" },
    "canonical_truth": { "$ref": "#/$defs/section" },
    "actions": {
      "type": "object",
      "required": ["update", "suspend", "restore", "retire"],
      "properties": {
        "update": { "$ref": "#/$defs/action" },
        "suspend": { "$ref": "#/$defs/action" },
        "restore": { "$ref": "#/$defs/action" },
        "retire": { "$ref": "#/$defs/action" }
      },
      "additionalProperties": false
    },
    "state_axes": { "$ref": "#/$defs/section" },
    "command_contract": { "$ref": "#/$defs/section" },
    "history_contract": { "$ref": "#/$defs/section" },
    "review_boundary": { "$ref": "#/$defs/section" },
    "denied_shortcuts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "section": { "type": "object", "minProperties": 1 },
    "action": {
      "type": "object",
      "required": ["allowed_from", "result"],
      "properties": {
        "allowed_from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["active", "suspended", "retired"] } },
        "result": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
