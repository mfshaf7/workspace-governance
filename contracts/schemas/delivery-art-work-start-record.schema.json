{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace-governance.local/contracts/schemas/delivery-art-work-start-record.schema.json",
  "title": "Delivery ART Work Start Record",
  "$comment": "Cross-field repo, branch-plan, and source-snapshot bindings are enforced by scripts/validate_contracts.py because JSON Schema cannot compare dynamic array members.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "delivery_id",
    "covered_work_item_ids",
    "created_at",
    "operator",
    "landing_unit",
    "architecture",
    "source_snapshot",
    "scope_fingerprint",
    "invalidation_inputs",
    "readiness",
    "integrity",
    "custody"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_type": { "const": "delivery_art_work_start_record" },
    "artifact_id": { "type": "string", "pattern": "^work-start:[a-z0-9][a-z0-9._:-]*$" },
    "delivery_id": { "$ref": "#/$defs/deliveryId" },
    "covered_work_item_ids": { "$ref": "#/$defs/workItemIds" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "operator": { "$ref": "#/$defs/operator" },
    "landing_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "split_reason",
        "owner_repos",
        "branch_plan",
        "planned_review_packet_ref"
      ],
      "properties": {
        "decision": {
          "enum": [
            "feature_single_landing_unit",
            "child_isolated_landing_unit",
            "non_source_child",
            "defer_decision_blocked"
          ]
        },
        "split_reason": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "owner_repos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoName" }
        },
        "branch_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "branch", "base_ref", "base_commit"],
            "properties": {
              "repo": { "$ref": "#/$defs/repoName" },
              "branch": { "$ref": "#/$defs/nonEmptyString" },
              "base_ref": { "$ref": "#/$defs/nonEmptyString" },
              "base_commit": { "$ref": "#/$defs/gitCommit" }
            }
          }
        },
        "planned_review_packet_ref": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "packet_ref", "packet_digest", "readiness"],
      "properties": {
        "required": { "type": "boolean" },
        "packet_ref": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "packet_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "readiness": { "enum": ["architecture-ready", "not-required", "blocked"] }
      }
    },
    "source_snapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "scope_fingerprint": { "$ref": "#/$defs/digest" },
    "invalidation_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "art-descendant-or-dependency-change",
          "owner-or-rollback-boundary-change",
          "base-ref-or-commit-change",
          "architecture-decision-or-digest-change",
          "validation-or-security-obligation-change"
        ]
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "evaluated_at", "blockers"],
      "properties": {
        "level": { "enum": ["draft", "implementation-ready", "blocked"] },
        "evaluated_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "integrity": { "$ref": "#/$defs/integrity" },
    "custody": { "$ref": "#/$defs/custody" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "landing_unit": {
            "properties": { "decision": { "const": "child_isolated_landing_unit" } },
            "required": ["decision"]
          }
        }
      },
      "then": {
        "properties": {
          "landing_unit": {
            "properties": { "split_reason": { "$ref": "#/$defs/nonEmptyString" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "landing_unit": {
            "properties": { "decision": { "const": "non_source_child" } },
            "required": ["decision"]
          }
        }
      },
      "then": {
        "properties": {
          "landing_unit": {
            "properties": {
              "branch_plan": { "maxItems": 0 },
              "planned_review_packet_ref": { "type": "null" }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "landing_unit": {
              "properties": { "decision": { "enum": ["feature_single_landing_unit", "child_isolated_landing_unit"] } },
              "required": ["decision"]
            }
          }
        },
        "then": {
          "properties": {
            "landing_unit": {
              "properties": {
                "branch_plan": { "minItems": 1 },
                "planned_review_packet_ref": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "architecture": {
            "properties": { "required": { "const": false } },
            "required": ["required"]
          }
        }
      },
      "then": {
        "properties": {
          "architecture": {
            "properties": {
              "packet_ref": { "type": "null" },
              "packet_digest": { "type": "null" },
              "readiness": { "const": "not-required" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "architecture": {
            "properties": {
              "readiness": { "enum": ["architecture-ready", "blocked"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": { "level": { "const": "implementation-ready" } },
            "required": ["level"]
          },
          "architecture": {
            "properties": { "required": { "const": true } },
            "required": ["required"]
          }
        },
        "required": ["readiness", "architecture"]
      },
      "then": {
        "properties": {
          "architecture": {
            "properties": {
              "packet_ref": { "$ref": "#/$defs/nonEmptyString" },
              "packet_digest": { "$ref": "#/$defs/digest" },
              "readiness": { "const": "architecture-ready" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": { "level": { "const": "implementation-ready" } },
            "required": ["level"]
          }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "evaluated_at": { "$ref": "#/$defs/timestamp" },
              "blockers": { "maxItems": 0 }
            }
          },
          "landing_unit": {
            "properties": {
              "decision": {
                "enum": ["feature_single_landing_unit", "child_isolated_landing_unit", "non_source_child"]
              }
            }
          },
          "custody": {
            "properties": {
              "state": { "const": "durable" },
              "backend": { "const": "openproject-attachment" },
              "persisted_at": { "$ref": "#/$defs/timestamp" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": { "level": { "const": "draft" } },
            "required": ["level"]
          }
        }
      },
      "then": {
        "properties": {
          "custody": {
            "properties": {
              "state": { "const": "local-draft" },
              "backend": { "const": "local-filesystem" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "readiness": { "properties": { "evaluated_at": { "$ref": "#/$defs/timestamp" } } },
          "custody": {
            "properties": {
              "state": { "const": "durable" },
              "backend": { "const": "openproject-attachment" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "deliveryId": { "type": "string", "pattern": "^delivery-[1-9][0-9]*$" },
    "workItemId": { "type": "string", "pattern": "^work-item-[1-9][0-9]*$" },
    "workItemIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/workItemId" }
    },
    "repoName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision_source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "decision_source": { "enum": ["operator", "approved-ai-suggestion"] }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "art_ref", "art_digest", "repo_revisions"],
      "properties": {
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "art_ref": { "type": "string", "pattern": "^openproject://work_packages/[1-9][0-9]*$" },
        "art_digest": { "$ref": "#/$defs/digest" },
        "repo_revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "base_ref", "commit"],
            "properties": {
              "repo": { "$ref": "#/$defs/repoName" },
              "base_ref": { "$ref": "#/$defs/nonEmptyString" },
              "commit": { "$ref": "#/$defs/gitCommit" }
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "algorithm", "content_digest"],
      "properties": {
        "canonicalization": { "const": "RFC8785" },
        "algorithm": { "const": "sha256" },
        "content_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "$ref": "#/$defs/nonEmptyString" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "backend", "uri", "persisted_at", "supersedes"],
      "properties": {
        "state": { "enum": ["local-draft", "durable"] },
        "backend": { "enum": ["local-filesystem", "openproject-attachment"] },
        "uri": { "$ref": "#/$defs/nonEmptyString" },
        "persisted_at": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "supersedes": {
          "oneOf": [
            { "$ref": "#/$defs/artifactRef" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
