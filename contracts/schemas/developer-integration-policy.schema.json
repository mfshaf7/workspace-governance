{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "lane",
    "lane_classes",
    "profile_lifecycle",
    "controlled_proof",
    "request_admission",
    "source_state",
    "runtime_state_models",
    "testing",
    "trigger_guidance",
    "runtime_lane_decision",
    "forbidden_targets",
    "live_miss_escalation",
    "required_actions",
    "required_handoff_artifacts",
    "required_session_fields"
  ],
  "$defs": {
    "repoPathRef": {
      "type": "object",
      "required": ["repo", "path"],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": 2 },
    "lane": {
      "type": "object",
      "required": [
        "id",
        "standard_owner",
        "runtime_owner",
        "delivery_model",
        "runtime_target",
        "governed_handoff_target"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "standard_owner": { "type": "string", "minLength": 1 },
        "runtime_owner": { "type": "string", "minLength": 1 },
        "delivery_model": { "type": "string", "minLength": 1 },
        "runtime_target": { "type": "string", "minLength": 1 },
        "governed_handoff_target": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lane_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "governed_runtime_evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "governed_runtime_evidence": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "profile_lifecycle": {
      "type": "object",
      "required": [
        "statuses",
        "implementation_statuses",
        "self_serve_statuses",
        "request_record_required",
        "build_admission_required_for",
        "platform_acceptance_required_for",
        "security_review_ref_required_when_flagged"
      ],
      "properties": {
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation_statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "self_serve_statuses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "request_record_required": { "type": "boolean" },
        "build_admission_required_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "platform_acceptance_required_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "security_review_ref_required_when_flagged": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "controlled_proof": {
      "type": "object",
      "required": [
        "purpose",
        "authority_type",
        "drill_type",
        "eligible_profile_statuses",
        "changes_profile_lifecycle",
        "self_serve_launch_allowed",
        "normal_profile_launch_remains_denied",
        "permit",
        "result",
        "authorities",
        "owner_surfaces",
        "completion",
        "forbidden_claims"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority_type": {
          "const": "runtime-drill"
        },
        "drill_type": {
          "const": "component-commissioning-proof"
        },
        "eligible_profile_statuses": {
          "type": "array",
          "prefixItems": [
            {
              "const": "build-admitted"
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "changes_profile_lifecycle": {
          "const": false
        },
        "self_serve_launch_allowed": {
          "const": false
        },
        "normal_profile_launch_remains_denied": {
          "const": true
        },
        "permit": {
          "type": "object",
          "required": [
            "schema_ref",
            "schema_version",
            "required_sections",
            "exact_scope_required",
            "expiration_required",
            "permit_issuer_binding_required",
            "executor_binding_required",
            "semantic_validation"
          ],
          "properties": {
            "schema_ref": {
              "type": "string",
              "minLength": 1
            },
            "schema_version": {
              "const": 4
            },
            "required_sections": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exact_scope_required": {
              "const": true
            },
            "expiration_required": {
              "const": true
            },
            "permit_issuer_binding_required": {
              "const": true
            },
            "executor_binding_required": {
              "const": true
            },
            "semantic_validation": {
              "type": "object",
              "required": [
                "unique_binding_keys",
                "canonical_claims",
                "approval_provenance",
                "session_consumption",
                "scenario_execution_binding",
                "window_validation",
                "immutable_baseline_digest_required"
              ],
              "properties": {
                "unique_binding_keys": {
                  "type": "object",
                  "required": [
                    "execution_source_revisions",
                    "runtime_artifacts",
                    "runtime_images"
                  ],
                  "properties": {
                    "execution_source_revisions": {
                      "const": "repo"
                    },
                    "runtime_artifacts": {
                      "const": "artifact_id"
                    },
                    "runtime_images": {
                      "const": "image_ref"
                    }
                  },
                  "additionalProperties": false
                },
                "approval_provenance": {
                  "type": "object",
                  "required": [
                    "security_authorization"
                  ],
                  "properties": {
                    "security_authorization": {
                      "type": "object",
                      "required": [
                        "source_repo_required",
                        "merged_source_revision_required",
                        "source_path_required",
                        "artifact_ref_required",
                        "artifact_digest_required",
                        "excluded_from_canonical_claims"
                      ],
                      "properties": {
                        "source_repo_required": {
                          "const": true
                        },
                        "merged_source_revision_required": {
                          "const": true
                        },
                        "source_path_required": {
                          "const": true
                        },
                        "artifact_ref_required": {
                          "const": true
                        },
                        "artifact_digest_required": {
                          "const": true
                        },
                        "excluded_from_canonical_claims": {
                          "const": true
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "canonical_claims": {
                  "type": "object",
                  "required": [
                    "canonicalization",
                    "projection",
                    "approvals_bind_complete_claims",
                    "approval_artifact_digests_required",
                    "execution_source_revisions_exclude_security_authorization_source"
                  ],
                  "properties": {
                    "canonicalization": {
                      "const": "rfc8785"
                    },
                    "projection": {
                      "const": "all-authorization-fields-except-approvals"
                    },
                    "approvals_bind_complete_claims": {
                      "const": true
                    },
                    "approval_artifact_digests_required": {
                      "const": true
                    },
                    "execution_source_revisions_exclude_security_authorization_source": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "session_consumption": {
                  "type": "object",
                  "required": [
                    "mode",
                    "keyed_by",
                    "consume_before_first_mutation",
                    "duplicate_consumption_denied"
                  ],
                  "properties": {
                    "mode": {
                      "const": "atomic-single-use"
                    },
                    "keyed_by": {
                      "const": "authorization_id"
                    },
                    "consume_before_first_mutation": {
                      "const": true
                    },
                    "duplicate_consumption_denied": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "scenario_execution_binding": {
                  "type": "object",
                  "required": [
                    "exact_authorized_set_required",
                    "scenario_ids_must_be_unique",
                    "scenario_execution_ids_must_be_unique",
                    "required_receipt_owners_declared_per_execution"
                  ],
                  "properties": {
                    "exact_authorized_set_required": {
                      "const": true
                    },
                    "scenario_ids_must_be_unique": {
                      "const": true
                    },
                    "scenario_execution_ids_must_be_unique": {
                      "const": true
                    },
                    "required_receipt_owners_declared_per_execution": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "window_validation": {
                  "type": "object",
                  "required": [
                    "issued_before_expiry",
                    "acceptance_time_within_window"
                  ],
                  "properties": {
                    "issued_before_expiry": {
                      "const": true
                    },
                    "acceptance_time_within_window": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "immutable_baseline_digest_required": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "required": [
            "schema_ref",
            "schema_version",
            "authorization_binding_required",
            "authorization_artifact_digest_canonicalization",
            "authorization_artifact_digest_projection",
            "authorization_artifact_digest_must_match_consumed_permit",
            "commissioning_session_binding_required",
            "scenario_outcomes_required",
            "scenario_outcomes_bind_execution_id",
            "scenario_ids_must_be_unique",
            "scenario_execution_ids_must_be_unique",
            "scenario_ids_must_exactly_match_authorization",
            "owner_receipts_required",
            "owner_receipt_pairs_must_be_unique",
            "passed_receipt_pairs_must_exactly_match_authorization",
            "owner_receipts_bind_authorization_session_execution_and_result",
            "timeline_validation",
            "exact_baseline_evidence_required",
            "baseline_snapshot_must_match_authorization"
          ],
          "properties": {
            "schema_ref": {
              "const": "contracts/schemas/controlled-runtime-proof-result.schema.json"
            },
            "schema_version": {
              "const": 2
            },
            "authorization_binding_required": {
              "const": true
            },
            "authorization_artifact_digest_canonicalization": {
              "const": "rfc8785"
            },
            "authorization_artifact_digest_projection": {
              "const": "complete-authorization"
            },
            "authorization_artifact_digest_must_match_consumed_permit": {
              "const": true
            },
            "commissioning_session_binding_required": {
              "const": true
            },
            "scenario_outcomes_required": {
              "const": true
            },
            "scenario_outcomes_bind_execution_id": {
              "const": true
            },
            "scenario_ids_must_be_unique": {
              "const": true
            },
            "scenario_execution_ids_must_be_unique": {
              "const": true
            },
            "scenario_ids_must_exactly_match_authorization": {
              "const": true
            },
            "owner_receipts_required": {
              "const": true
            },
            "owner_receipt_pairs_must_be_unique": {
              "const": true
            },
            "passed_receipt_pairs_must_exactly_match_authorization": {
              "const": true
            },
            "owner_receipts_bind_authorization_session_execution_and_result": {
              "const": true
            },
            "timeline_validation": {
              "type": "object",
              "required": [
                "consumption_within_authorization_window",
                "consumed_before_session_start",
                "session_start_within_authorization_window",
                "scenario_start_within_authorization_window",
                "scenario_completion_not_before_start",
                "result_completion_not_before_scenarios",
                "passed_completion_before_expiry"
              ],
              "properties": {
                "consumption_within_authorization_window": {
                  "const": true
                },
                "consumed_before_session_start": {
                  "const": true
                },
                "session_start_within_authorization_window": {
                  "const": true
                },
                "scenario_start_within_authorization_window": {
                  "const": true
                },
                "scenario_completion_not_before_start": {
                  "const": true
                },
                "result_completion_not_before_scenarios": {
                  "const": true
                },
                "passed_completion_before_expiry": {
                  "const": true
                }
              },
              "additionalProperties": false
            },
            "exact_baseline_evidence_required": {
              "const": true
            },
            "baseline_snapshot_must_match_authorization": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "authorities": {
          "type": "object",
          "required": [
            "issuer",
            "permit_issuer_source_review_required",
            "executor_owner",
            "executor_source_review_required",
            "security_authorizer",
            "operator_approval_required"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "permit_issuer_source_review_required": {
              "const": true
            },
            "executor_owner": {
              "type": "string",
              "minLength": 1
            },
            "executor_source_review_required": {
              "const": true
            },
            "security_authorizer": {
              "type": "string",
              "minLength": 1
            },
            "operator_approval_required": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "owner_surfaces": {
          "type": "object",
          "required": [
            "platform_operator",
            "platform_profile",
            "security_contract_review"
          ],
          "properties": {
            "platform_operator": {
              "$ref": "#/$defs/repoPathRef"
            },
            "platform_profile": {
              "$ref": "#/$defs/repoPathRef"
            },
            "security_contract_review": {
              "$ref": "#/$defs/repoPathRef"
            }
          },
          "additionalProperties": false
        },
        "completion": {
          "type": "object",
          "required": [
            "restore_mode",
            "restore_required_before_completion",
            "terminal_cleanup_authority_mode",
            "terminal_cleanup_bound_to_started_session",
            "terminal_cleanup_trigger_scope",
            "new_proof_actions_allowed_after_stop",
            "post_proof_security_review_required",
            "pre_run_authorization_reusable_as_activation_evidence"
          ],
          "properties": {
            "restore_mode": {
              "const": "exact-baseline"
            },
            "restore_required_before_completion": {
              "const": true
            },
            "terminal_cleanup_authority_mode": {
              "const": "exact-baseline-restore-only"
            },
            "terminal_cleanup_bound_to_started_session": {
              "const": true
            },
            "terminal_cleanup_trigger_scope": {
              "const": "any-triggered-stop-condition"
            },
            "new_proof_actions_allowed_after_stop": {
              "const": false
            },
            "post_proof_security_review_required": {
              "const": true
            },
            "pre_run_authorization_reusable_as_activation_evidence": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "request_admission": {
      "type": "object",
      "required": [
        "current_request_adapter",
        "required_request_fields",
        "activation_requirements",
        "build_admission_requirements",
        "persistent_request_requirements"
      ],
      "properties": {
        "current_request_adapter": {
          "type": "object",
          "required": ["system", "owner_repo", "target_ref"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "owner_repo": { "type": "string", "minLength": 1 },
            "target_ref": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "required_request_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "activation_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "build_admission_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "persistent_request_requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "source_state": {
      "type": "object",
      "required": [
        "allow_dirty_worktrees",
        "allow_local_only_commits",
        "allow_branch_inputs",
        "allow_worktree_path_overrides",
        "session_manifest_required"
      ],
      "properties": {
        "allow_dirty_worktrees": { "type": "boolean" },
        "allow_local_only_commits": { "type": "boolean" },
        "allow_branch_inputs": { "type": "boolean" },
        "allow_worktree_path_overrides": { "type": "boolean" },
        "session_manifest_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "runtime_state_models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "testing": {
      "type": "object",
      "required": ["smoke"],
      "properties": {
        "smoke": {
          "type": "object",
          "required": ["allowed_mutation_modes", "persistent_profile_rule"],
          "properties": {
            "allowed_mutation_modes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "persistent_profile_rule": {
              "type": "object",
              "required": [
                "mutation_mode_must_be",
                "mutating_smoke_requires_separate_disposable_profile"
              ],
              "properties": {
                "mutation_mode_must_be": { "type": "string", "minLength": 1 },
                "mutating_smoke_requires_separate_disposable_profile": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "trigger_guidance": {
      "type": "object",
      "required": ["required", "recommended", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "runtime_lane_decision": {
      "type": "object",
      "required": [
        "required_for_new_repos",
        "decisions",
        "component_inventory_required_repo_classes",
        "dev_integration_required_repo_classes",
        "waiver_decisions",
        "waivers"
      ],
      "properties": {
        "required_for_new_repos": { "type": "boolean" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "component_inventory_required_repo_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dev_integration_required_repo_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "waiver_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "decision", "reason", "review_due_on"],
            "properties": {
              "repo": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "review_due_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "forbidden_targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "live_miss_escalation": {
      "type": "object",
      "required": [
        "owner_repo",
        "purpose",
        "return_to_dev_integration_when",
        "route_to_platform_or_backend_boundary_when",
        "governed_rehearsal_allowed_when",
        "required_record_fields"
      ],
      "properties": {
        "owner_repo": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "return_to_dev_integration_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "route_to_platform_or_backend_boundary_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "governed_rehearsal_allowed_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_record_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "required_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_handoff_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_session_fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
