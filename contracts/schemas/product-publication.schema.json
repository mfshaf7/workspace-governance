{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "product_publication"],
  "properties": {
    "schema_version": { "const": 2 },
    "product_publication": {
      "type": "object",
      "required": [
        "owner_repo", "implementation_posture", "primary_operator_surface",
        "product_inventory_ref", "lifecycle_contract_ref", "purpose",
        "authorities", "vocabulary", "posture_bindings", "action_bindings",
        "artifact_contracts", "manifest_obligations", "packet_obligations",
        "history_contract", "semantic_rules", "denied_shortcuts"
      ],
      "properties": {
        "owner_repo": { "const": "workspace-governance" },
        "implementation_posture": { "const": "contract-ready" },
        "primary_operator_surface": { "const": "docs/product-publication.md" },
        "product_inventory_ref": { "const": "contracts/products.yaml" },
        "lifecycle_contract_ref": { "const": "contracts/project-lifecycle.yaml" },
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "authorities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/authority" }
        },
        "vocabulary": {
          "type": "object",
          "required": [
            "product_classifications", "product_lifecycle_states",
            "publication_postures", "listing_scopes", "audiences",
            "access_classes", "publication_actions"
          ],
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        },
        "posture_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/postureBinding" }
        },
        "action_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/actionBinding" }
        },
        "artifact_contracts": {
          "type": "object",
          "required": ["owner_manifest", "publication_packet", "terminal_receipt"],
          "additionalProperties": { "$ref": "#/$defs/artifactContract" }
        },
        "manifest_obligations": { "$ref": "#/$defs/nonEmptyObject" },
        "packet_obligations": { "$ref": "#/$defs/nonEmptyObject" },
        "history_contract": { "$ref": "#/$defs/nonEmptyObject" },
        "semantic_rules": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "denied_shortcuts": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "nonEmptyUniqueStrings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "nonEmptyObject": { "type": "object", "minProperties": 1 },
    "authority": {
      "type": "object",
      "required": ["owner_kind", "owner_ref", "responsibilities"],
      "properties": {
        "owner_kind": { "enum": ["repo", "dynamic"] },
        "owner_ref": { "$ref": "#/$defs/identifier" },
        "responsibilities": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      },
      "additionalProperties": false
    },
    "postureBinding": {
      "type": "object",
      "required": ["listing_scope", "audience", "access_class", "allowed_lifecycle_states"],
      "properties": {
        "listing_scope": { "type": ["string", "null"] },
        "audience": { "type": ["string", "null"] },
        "access_class": { "type": ["string", "null"] },
        "allowed_lifecycle_states": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      },
      "additionalProperties": false
    },
    "actionBinding": {
      "type": "object",
      "required": ["allowed_source_postures", "allowed_target_postures"],
      "properties": {
        "allowed_source_postures": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "allowed_target_postures": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      },
      "additionalProperties": false
    },
    "artifactContract": {
      "type": "object",
      "required": ["schema_ref", "authority_role", "digest_scope"],
      "properties": {
        "schema_ref": { "$ref": "#/$defs/nonEmptyString" },
        "authority_role": { "$ref": "#/$defs/identifier" },
        "digest_scope": { "const": "canonical-json-entire-artifact" }
      },
      "additionalProperties": false
    }
  }
}
