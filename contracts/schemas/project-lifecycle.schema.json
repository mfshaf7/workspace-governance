{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "project_lifecycle"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project_lifecycle": {
      "type": "object",
      "required": [
        "owner_repo",
        "implementation_posture",
        "primary_architecture_surface",
        "purpose",
        "axis_order",
        "axes",
        "ownership_roles",
        "evidence_types",
        "envelopes",
        "recovery_contract",
        "transitions",
        "state_invariants",
        "denied_claims"
      ],
      "properties": {
        "owner_repo": { "const": "workspace-governance" },
        "implementation_posture": { "const": "contract-only" },
        "primary_architecture_surface": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "axis_order": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axisId" }
        },
        "axes": {
          "type": "object",
          "required": [
            "project-phase",
            "source-custody",
            "runtime-environment",
            "release-posture",
            "publication-posture"
          ],
          "properties": {
            "project-phase": { "$ref": "#/$defs/axis" },
            "source-custody": { "$ref": "#/$defs/axis" },
            "runtime-environment": { "$ref": "#/$defs/axis" },
            "release-posture": { "$ref": "#/$defs/axis" },
            "publication-posture": { "$ref": "#/$defs/axis" }
          },
          "additionalProperties": false
        },
        "ownership_roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/ownershipRole" }
        },
        "evidence_types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["owner_role"],
            "properties": {
              "owner_role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "envelopes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["required_fields"],
            "properties": {
              "required_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "recovery_contract": {
          "type": "object",
          "required": ["allowed_decisions", "requirements", "rule"],
          "properties": {
            "allowed_decisions": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/recoveryDecision" }
            },
            "requirements": {
              "type": "object",
              "required": ["remove", "workaround", "accept-risk", "defer"],
              "properties": {
                "remove": { "$ref": "#/$defs/requiredFieldList" },
                "workaround": { "$ref": "#/$defs/requiredFieldList" },
                "accept-risk": { "$ref": "#/$defs/requiredFieldList" },
                "defer": { "$ref": "#/$defs/requiredFieldList" }
              },
              "additionalProperties": false
            },
            "rule": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/transition" }
        },
        "state_invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateInvariant" }
        },
        "denied_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axisId": {
      "enum": [
        "project-phase",
        "source-custody",
        "runtime-environment",
        "release-posture",
        "publication-posture"
      ]
    },
    "state": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "required": ["responsibility", "authority_roles", "description", "states"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "authority_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "states": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/state" }
        }
      },
      "additionalProperties": false
    },
    "ownershipRole": {
      "type": "object",
      "required": ["owner_kind", "owner_ref", "mode", "responsibilities"],
      "properties": {
        "owner_kind": { "enum": ["repo", "dynamic"] },
        "owner_ref": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["authority", "projection"] },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "requiredFieldList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recoveryDecision": {
      "enum": ["remove", "workaround", "accept-risk", "defer"]
    },
    "stateCondition": {
      "type": "object",
      "required": ["axis", "states"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "precondition": {
      "type": "object",
      "required": ["axis", "allowed_states"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "axis",
        "from_states",
        "to_states",
        "source_authority_role",
        "target_owner_role",
        "required_envelope",
        "required_evidence",
        "allowed_recovery_decisions",
        "preconditions"
      ],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "from_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "to_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_authority_role": { "type": "string", "minLength": 1 },
        "target_owner_role": { "type": "string", "minLength": 1 },
        "required_envelope": { "type": "string", "minLength": 1 },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_recovery_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recoveryDecision" }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        }
      },
      "additionalProperties": false
    },
    "stateInvariant": {
      "type": "object",
      "required": ["invariant_id", "when", "requires"],
      "properties": {
        "invariant_id": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/stateCondition" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateCondition" }
        }
      },
      "additionalProperties": false
    }
  }
}
