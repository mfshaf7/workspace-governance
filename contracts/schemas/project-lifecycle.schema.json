{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "project_lifecycle"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "project_lifecycle": {
      "type": "object",
      "required": [
        "owner_repo",
        "implementation_posture",
        "primary_architecture_surface",
        "purpose",
        "axis_order",
        "axes",
        "ownership_roles",
        "evidence_types",
        "envelopes",
        "recovery_contract",
        "projection_contract",
        "transitions",
        "state_invariants",
        "denied_claims"
      ],
      "properties": {
        "owner_repo": { "const": "workspace-governance" },
        "implementation_posture": { "const": "contract-only" },
        "primary_architecture_surface": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "axis_order": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axisId" }
        },
        "axes": {
          "type": "object",
          "required": [
            "project-phase",
            "source-custody",
            "runtime-environment",
            "release-posture",
            "publication-posture"
          ],
          "properties": {
            "project-phase": { "$ref": "#/$defs/axis" },
            "source-custody": { "$ref": "#/$defs/axis" },
            "runtime-environment": { "$ref": "#/$defs/axis" },
            "release-posture": { "$ref": "#/$defs/axis" },
            "publication-posture": { "$ref": "#/$defs/axis" }
          },
          "additionalProperties": false
        },
        "ownership_roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/ownershipRole" }
        },
        "evidence_types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["owner_role"],
            "properties": {
              "owner_role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "envelopes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["required_fields"],
            "properties": {
              "required_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "recovery_contract": {
          "type": "object",
          "required": ["allowed_decisions", "requirements", "rule"],
          "properties": {
            "allowed_decisions": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/recoveryDecision" }
            },
            "requirements": {
              "type": "object",
              "required": ["remove", "workaround", "accept-risk", "defer"],
              "properties": {
                "remove": { "$ref": "#/$defs/requiredFieldList" },
                "workaround": { "$ref": "#/$defs/requiredFieldList" },
                "accept-risk": { "$ref": "#/$defs/requiredFieldList" },
                "defer": { "$ref": "#/$defs/requiredFieldList" }
              },
              "additionalProperties": false
            },
            "rule": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "projection_contract": { "$ref": "#/$defs/projectionContract" },
        "transitions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/transition" }
        },
        "state_invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateInvariant" }
        },
        "denied_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "axisId": {
      "enum": [
        "project-phase",
        "source-custody",
        "runtime-environment",
        "release-posture",
        "publication-posture"
      ]
    },
    "state": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "required": ["responsibility", "authority_roles", "description", "states"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "authority_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "states": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/state" }
        }
      },
      "additionalProperties": false
    },
    "ownershipRole": {
      "type": "object",
      "required": ["owner_kind", "owner_ref", "mode", "responsibilities"],
      "properties": {
        "owner_kind": { "enum": ["repo", "dynamic"] },
        "owner_ref": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["authority", "projection"] },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "requiredFieldList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "recoveryDecision": {
      "enum": ["remove", "workaround", "accept-risk", "defer"]
    },
    "projectionContract": {
      "type": "object",
      "required": [
        "schema_ref",
        "schema_version",
        "contract_maturity",
        "runtime_maturity",
        "purpose",
        "source_authority_envelope",
        "locked_routes",
        "states",
        "next_actions",
        "terminal_states",
        "history_event_kinds",
        "invariants"
      ],
      "properties": {
        "schema_ref": {
          "const": "contracts/schemas/lifecycle-transition-projection.schema.json"
        },
        "schema_version": { "const": 1 },
        "contract_maturity": { "const": "contract-ready" },
        "runtime_maturity": { "const": "contract-only" },
        "purpose": { "type": "string", "minLength": 1 },
        "source_authority_envelope": {
          "type": "object",
          "required": [
            "artifact_type",
            "authority",
            "source_owner",
            "required_sections",
            "accepted_freshness_states",
            "live_consumer_rule",
            "disconnected_preview_rule"
          ],
          "properties": {
            "artifact_type": { "const": "console-source-projection" },
            "authority": { "const": "operator-orchestration-service" },
            "source_owner": { "const": "operator-orchestration-service" },
            "required_sections": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["binding", "freshness", "revision", "projection"] }
            },
            "accepted_freshness_states": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["current", "stale", "unavailable", "unknown"] }
            },
            "live_consumer_rule": { "type": "string", "minLength": 1 },
            "disconnected_preview_rule": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "locked_routes": {
          "type": "object",
          "required": [
            "proposal-to-delivery",
            "proposal-to-prototype",
            "prototype-to-delivery"
          ],
          "properties": {
            "proposal-to-delivery": { "$ref": "#/$defs/projectionRoute" },
            "proposal-to-prototype": { "$ref": "#/$defs/projectionRoute" },
            "prototype-to-delivery": { "$ref": "#/$defs/projectionRoute" }
          },
          "additionalProperties": false
        },
        "states": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectionState" }
        },
        "next_actions": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectionNextAction" }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["applied", "cancelled", "superseded"] }
        },
        "history_event_kinds": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectionHistoryEventKind" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "projectionRoute": {
      "type": "object",
      "required": [
        "canonical_transition_id",
        "source_domain",
        "intent_owner_ref",
        "target_domain",
        "target_home_ref",
        "target_ingress_ref",
        "target_lane_ref",
        "target_admission_owner_ref",
        "target_application_owner_ref",
        "validation_owner_ref",
        "execution_owner_ref",
        "completion_evidence"
      ],
      "properties": {
        "canonical_transition_id": { "type": "string", "minLength": 1 },
        "source_domain": { "enum": ["proposal", "prototype"] },
        "intent_owner_ref": { "type": "string", "minLength": 1 },
        "target_domain": { "enum": ["delivery", "prototype"] },
        "target_home_ref": { "type": "string", "minLength": 1 },
        "target_ingress_ref": { "type": "string", "minLength": 1 },
        "target_lane_ref": { "type": "string", "minLength": 1 },
        "target_admission_owner_ref": { "type": "string", "minLength": 1 },
        "target_application_owner_ref": { "type": "string", "minLength": 1 },
        "validation_owner_ref": { "type": "string", "minLength": 1 },
        "execution_owner_ref": { "type": "string", "minLength": 1 },
        "completion_evidence": {
          "enum": ["target-admission-receipt", "target-application-receipt"]
        }
      },
      "additionalProperties": false
    },
    "projectionState": {
      "enum": [
        "prepared",
        "validating",
        "awaiting-authority",
        "awaiting-admission",
        "authorized",
        "applying",
        "blocked",
        "returned",
        "deferred",
        "rejected",
        "failed",
        "applied",
        "cancelled",
        "superseded"
      ]
    },
    "projectionNextAction": {
      "enum": [
        "start-validation",
        "complete-validation",
        "record-authority-decision",
        "record-admission",
        "start-application",
        "complete-application",
        "resolve-gate",
        "correct-source",
        "review-deferred-transition",
        "review-rejection",
        "retry-application"
      ]
    },
    "projectionHistoryEventKind": {
      "enum": [
        "source-packet-prepared",
        "validation-started",
        "validation-completed",
        "target-admission-recorded",
        "authority-decision-recorded",
        "application-started",
        "target-application-recorded",
        "application-failed",
        "gate-blocked",
        "source-correction-returned",
        "transition-deferred",
        "transition-cancelled",
        "transition-superseded"
      ]
    },
    "stateCondition": {
      "type": "object",
      "required": ["axis", "states"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "precondition": {
      "type": "object",
      "required": ["axis", "allowed_states"],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "allowed_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "axis",
        "implementation_maturity",
        "from_states",
        "to_states",
        "source_authority_role",
        "target_owner_role",
        "required_envelope",
        "required_evidence",
        "allowed_recovery_decisions",
        "preconditions"
      ],
      "properties": {
        "axis": { "$ref": "#/$defs/axisId" },
        "implementation_maturity": { "$ref": "#/$defs/implementationMaturity" },
        "from_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "to_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "source_authority_role": { "type": "string", "minLength": 1 },
        "target_owner_role": { "type": "string", "minLength": 1 },
        "required_envelope": { "type": "string", "minLength": 1 },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_recovery_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recoveryDecision" }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/precondition" }
        }
      },
      "additionalProperties": false
    },
    "implementationMaturity": {
      "enum": ["contract-only", "locally-proven", "dev-integration", "governed"]
    },
    "stateInvariant": {
      "type": "object",
      "required": ["invariant_id", "when", "requires"],
      "properties": {
        "invariant_id": { "type": "string", "minLength": 1 },
        "when": { "$ref": "#/$defs/stateCondition" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stateCondition" }
        }
      },
      "additionalProperties": false
    }
  }
}
