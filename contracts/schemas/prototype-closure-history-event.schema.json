{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype Closure Studio Source Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "event_id", "request_ref", "request_digest", "prototype_id", "event_type", "expected_source_revision", "previous_lifecycle", "observed_lifecycle", "previous_source_custody", "observed_source_custody", "operator_id", "correlation_id", "idempotency_key", "prior_event_digest", "recorded_at"],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_type": {"const": "prototype-closure-history-event"},
    "event_id": {"$ref": "#/$defs/text"},
    "request_ref": {"$ref": "#/$defs/text"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "prototype_id": {"$ref": "#/$defs/text"},
    "event_type": {"enum": ["delivery-accepted", "source-graduated", "incubation-retired", "incubation-reopened"]},
    "expected_source_revision": {"$ref": "#/$defs/text"},
    "previous_lifecycle": {"enum": ["exploring", "candidate", "baseline-approved", "graduating", "retired"]},
    "observed_lifecycle": {"enum": ["exploring", "candidate", "baseline-approved", "graduating", "graduated", "retired"]},
    "previous_source_custody": {"enum": ["incubation-repo", "dedicated-owner-repo", "shared-owner-repo"]},
    "observed_source_custody": {"enum": ["incubation-repo", "dedicated-owner-repo", "shared-owner-repo"]},
    "operator_id": {"$ref": "#/$defs/text"},
    "correlation_id": {"$ref": "#/$defs/text"},
    "idempotency_key": {"$ref": "#/$defs/text"},
    "accepted_baseline_receipt_ref": {"$ref": "#/$defs/text"},
    "accepted_delivery_target_receipt_ref": {"$ref": "#/$defs/text"},
    "durable_owner_acceptance_ref": {"$ref": "#/$defs/text"},
    "source_transfer_receipt_ref": {"$ref": "#/$defs/text"},
    "already_owned_source_proof_ref": {"$ref": "#/$defs/text"},
    "retention_plan_ref": {"$ref": "#/$defs/text"},
    "runtime_disposition_proof_ref": {"$ref": "#/$defs/text"},
    "prior_retirement_receipt_ref": {"$ref": "#/$defs/text"},
    "retained_source_readback_ref": {"$ref": "#/$defs/text"},
    "prior_event_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "delivery-accepted"}}}, "then": {"required": ["accepted_baseline_receipt_ref", "accepted_delivery_target_receipt_ref"], "properties": {"observed_lifecycle": {"const": "graduating"}, "observed_source_custody": {"const": "incubation-repo"}}}},
    {"if": {"properties": {"event_type": {"const": "source-graduated"}}}, "then": {"required": ["accepted_delivery_target_receipt_ref", "durable_owner_acceptance_ref"], "properties": {"observed_lifecycle": {"const": "graduated"}, "observed_source_custody": {"enum": ["dedicated-owner-repo", "shared-owner-repo"]}}, "oneOf": [{"required": ["source_transfer_receipt_ref"], "not": {"required": ["already_owned_source_proof_ref"]}}, {"required": ["already_owned_source_proof_ref"], "not": {"required": ["source_transfer_receipt_ref"]}}]}},
    {"if": {"properties": {"event_type": {"const": "incubation-retired"}}}, "then": {"required": ["retention_plan_ref", "runtime_disposition_proof_ref"], "properties": {"observed_lifecycle": {"const": "retired"}}}},
    {"if": {"properties": {"event_type": {"const": "incubation-reopened"}}}, "then": {"required": ["prior_retirement_receipt_ref", "retained_source_readback_ref"], "properties": {"observed_lifecycle": {"const": "exploring"}, "observed_source_custody": {"const": "incubation-repo"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
